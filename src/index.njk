---
permalink: /index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Ke Shi</title>
    <meta
      name="description"
      content="Ke Shi is a Master's student at USTC working on algorithms, combinatorial optimization, and approximate counting."
    />
    <link rel="canonical" href="https://keshi.pro/" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Ke Shi" />
    <meta
      property="og:description"
      content="Ke Shi is a Master's student at USTC working on algorithms, combinatorial optimization, and approximate counting."
    />
    <meta property="og:url" content="https://keshi.pro/" />
    <meta
      property="og:image"
      content="https://keshi.pro/files/pictures/anon-grey-540.jpg"
    />

    <link
      rel="preload"
      href="/css/katex/fonts/KaTeX_Main-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/katex/katex.min.css" />
    <link rel="icon" type="image/png" href="/files/pictures/terminal.512.png" />

    <link rel="stylesheet" href="/css/default.css" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="/css/homepage.css"
      crossorigin="anonymous"
    />

    <script>
      function togglePublication() {
        var x = document.getElementsByClassName("cv-non-selected");
        for (var i = x.length - 1; i >= 0; --i)
          x[i].classList.remove("cv-non-selected");
        x = document.getElementById("pub-toggle");
        x.style.display = "none";
      }
    </script>
  </head>
  <body>
    <!-- Material Icons (Apache 2.0) used by the publication list -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none">
      <symbol id="icon-expand-more" viewBox="0 0 24 24">
        <path d="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z" />
      </symbol>
      <symbol id="icon-expand-less" viewBox="0 0 24 24">
        <path d="m12 8-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z" />
      </symbol>
      <symbol id="icon-description" viewBox="0 0 24 24">
        <path
          d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
        />
      </symbol>
      <symbol id="icon-airplay" viewBox="0 0 24 24">
        <path
          d="M6 22h12l-6-6zM21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h4v-2H3V5h18v12h-4v2h4c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
        />
      </symbol>
    </svg>
    <div class="container">
      <div class="person" itemscope="" itemtype="http://schema.org/Person">
        <meta itemprop="gender" content="Male" />
        <meta itemprop="url" content="https://keshi.pro" />
        <div class="row" style="display: block">
          <h1 id="site-title">
            <span itemprop="givenName">Ke</span>
            <span itemprop="familyName">Shi</span> <wbr />|<wbr />
            <ruby><rb>史</rb><rp>(</rp><rt>shǐ</rt><rp>)</rp></ruby>
            <ruby><rb>可</rb><rp>(</rp><rt>kě</rt><rp>)</rp></ruby>
          </h1>
        </div>

        <div class="row">
          <div
            class="intro-left"
            itemprop="image"
            itemscope
            itemtype="http://schema.org/ImageObject"
          >
            <meta itemprop="representativeOfPage" content="True" />
            <picture>
              <source
                type="image/webp"
                srcset="
                  /files/pictures/anon-grey-270.webp 1x,
                  /files/pictures/anon-grey-540.webp 2x
                "
              />
              <img
                width="270"
                height="270"
                src="/files/pictures/anon-grey-540.jpg"
                style="border-radius: 50%; max-width: 95%"
                title="ahh"
                alt="Profile picture"
                fetchpriority="high"
                itemprop="contentUrl"
              />
            </picture>
          </div>
          <div class="intro-right">
            <p>
              I am a Master's student at <a href="https://ustc.edu/">USTC</a>,
              currently under the guidance of
              <a href="http://staff.ustc.edu.cn/~wwwucuc/">Shuai Shao</a>.
            </p>
            <p>
              Prior to this, I earned my Bachelor's degree in Computer Science
              from <a href="https://www.uestc.edu.cn/">UESTC</a> while
              conducting theoretical computer science research under the
              guidance of <a href="https://chaoxu.prof">Chao Xu</a>.
            </p>
            <p>
              My research interests revolve around algorithms and combinatorial
              optimization. Recently, my focus has been directed towards
              approximate counting algorithms and their correlations with the
              phenomenon of phase transitions in statistical physics. Here is my
              <a href="files/CV-en.pdf">CV</a>.
            </p>

            <p>
              You can contact me through email
              <a href="mailto:self.ke.shi@gmail.com"
                ><samp itemprop="email">self.ke.shi@gmail.com</samp></a
              >,
              <a href="mailto:ke.shi@ustc.edu"
                ><samp itemprop="email">ke.shi@ustc.edu</samp></a
              >
              or
              <a href="mailto:chihaya.anon@ustc.edu"
                ><samp itemprop="email">chihaya.anon@ustc.edu</samp></a
              >.
            </p>
          </div>
        </div>
      </div>

      <div class="row pubtypeheader" id="pub-toggle">
        <span
          >Selected Publications<br /><span
            style="font-size: 0.6em"
            onclick="togglePublication()"
            ><em><a>See all publications.</a></em></span
          ></span
        >
      </div>

      {% for pub_type in publications.pubTypes %}
      <div class="cv-non-selected row pubtypeheader">{{ pub_type.title | safe }}</div>
      {% for paper in pub_type.papers %}
      <div class="{{ paper.selected }} row cv-entry" id="{{ paper.id }}">
        <input
          type="checkbox"
          class="abstract-guard"
          id="{{ paper.id }}-toggle"
        />
        <div class="cv-left">
          {% if 'a' in paper.show %}
          <label class="showmore" for="{{ paper.id }}-toggle" title="Abstract"
            ><svg class="icon icon-more" aria-hidden="true">
              <use href="#icon-expand-more" /></svg
            ><svg class="icon icon-less" aria-hidden="true">
              <use href="#icon-expand-less" /></svg
          ></label>
          {% else %}
          <svg class="icon disabled" aria-hidden="true">
            <use href="#icon-expand-more" />
          </svg>
          {% endif %} {% if 'd' in paper.show %}
          <a href="files/papers/{{ paper.id }}.pdf" title="Paper (PDF)"
            ><svg class="icon" role="img" aria-label="Paper (PDF)">
              <use href="#icon-description" /></svg
          ></a>
          {% else %}
          <svg class="icon disabled" aria-hidden="true">
            <use href="#icon-description" />
          </svg>
          {% endif %} {% if 'p' in paper.show %}
          <a href="files/presentations/{{ paper.id }}.pdf" title="Slides (PDF)"
            ><svg class="icon" role="img" aria-label="Slides (PDF)">
              <use href="#icon-airplay" /></svg
          ></a>
          {% else %}
          <svg class="icon disabled" aria-hidden="true">
            <use href="#icon-airplay" />
          </svg>
          {% endif %}
        </div>

        <div class="cv-right">
          <cite class="paper-title">{{ paper.title | safe }}</cite>
          {% if paper.authors %}
          <ul class="coauthor-list">
            {% for author in paper.authors -%}
            <li>
              {%- if author.link %}<a href="{{ author.link }}">{{ author.name }}</a>
              {%- else %}{{ author.name }}{% endif -%}
            </li>
            {%- endfor %}
          </ul>
          {% endif %}

          <p>
            <em>
              {% if paper.bib %} {{ paper.bib }} {% elif paper.pub %} {% if
              pub_type.title == "Journal Publications" %} {{ paper.pub.venue }}
              <time>{{ paper.year }}</time>. {% else %}
              <abbr title="{{ paper.pub.venue }}">{{ paper.pub.name }}</abbr>
              <time>{{ paper.year }}</time>. {% endif %} {% else %}
              <time>{{ paper.year }}</time>. {% endif %}
            </em>
          </p>

          {% for note in paper.notes %}
          <aside class="cv-non-selected note">{{ note | safe }}</aside>
          {% endfor %}
        </div>

        {% if paper.abstract %}
        <div class="abstract">
          {{ paper.abstract | safe }} {% if paper.dedication %}
          <aside class="dedication">{{ paper.dedication | safe }}</aside>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% endfor %} {% endfor %}
    </div>
    <script>
      togglePublication();
    </script>
  </body>
</html>
